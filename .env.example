# ==============================================================================
# Neural Network Architecture Studio (NNAS) - Environment Configuration Template
# ==============================================================================

# Application & API
PROJECT_NAME="Neural Network Architecture Studio (NNAS)"
API_V1_STR="/api/v1"
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_FOR_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Standalone: sqlite:///./nnas_studio.db
# Production: postgresql://nnas_user:your_secure_password@localhost:5432/nnas_db
DATABASE_URL="sqlite:///./nnas_studio.db"

# Background Job Coordination & Redis
REDIS_URL="redis://localhost:6379/0"

# Object & Checkpoint Storage
# STORAGE_TYPE: "local" or "s3"
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./storage"

# S3 Configuration (Optional, when STORAGE_TYPE=s3)
S3_BUCKET="nnas-production-artifacts"
S3_ENDPOINT_URL="https://s3.amazonaws.com"
S3_ACCESS_KEY="REPLACE_WITH_S3_ACCESS_KEY"
S3_SECRET_KEY="REPLACE_WITH_S3_SECRET_KEY"

# Operational Limits & Security Quotas
MAX_UPLOAD_SIZE_MB=50
MAX_CONCURRENT_TRAINING_JOBS=4
